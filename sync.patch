+    }
+    for(i=0;i<p.nfunc;i++) {r->prog.funcs[fb+i]=p.funcs[i];r->prog.funcs[fb+i].entry+=base;}
+    r->prog.ncode=base+p.ncode;r->prog.nfunc=fb+p.nfunc;
