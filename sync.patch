+    free(owned);base=r->prog.ncode;fb=r->prog.nfunc;
+    if(p.ncode>1000000-base || p.nfunc>8192-fb) {gsc_prog_free(&p);rt_error(r,"GSC program limit");return -1;}
+    strings=(int*)malloc((size_t)(p.nstr?p.nstr:1)*sizeof(int));
