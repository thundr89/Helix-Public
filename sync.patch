+static void rt_method(GscRuntime* r,RtThread* t,int name,GscVal receiver,GscVal* args,int argc) {
+    const char* method=str_at(&r->prog,name);int id;
+    if(!rt_id(receiver,&id)){rt_error(r,"GSC method requires entity receiver");t->state=3;return;}
+    if(strcmp(method,"notify")==0 || strcmp(method,"waittill")==0 || strcmp(method,"endon")==0) {
+        if(argc<1 || args[0].kind!=V_STR){rt_error(r,"GSC event name must be string");t->state=3;return;}
+        if(strcmp(method,"notify")==0)rt_notify_values(r,id,args[0].s,args+1,argc-1);
+        else if(strcmp(method,"waittill")==0){t->state=2;t->event_entity=id;t->event_name=args[0].s;}
+        else if(t->nendon<RT_EVENTS){t->endon[t->nendon].entity=id;t->endon[t->nendon++].name=args[0].s;}
+        else {rt_error(r,"GSC endon limit");t->state=3;}
+    } else if(strcmp(method,"placeSpawnpoint")==0 || strcmp(method,"placeSpawnPoint")==0 || strcmp(method,"placespawnpoint")==0) {
+        if(argc || id<0 || !r->host.place_spawnpoint || !r->host.place_spawnpoint(r->host.user,id))
+            rt_error(r,"GSC spawnpoint placement rejected");
+    } else if(strcmp(method,"hide")==0 || strcmp(method,"show")==0 || strcmp(method,"delete")==0 || strcmp(method,"notsolid")==0 ||
+              strcmp(method,"unlinkFromWorld")==0 || strcmp(method,"linkIntoWorld")==0) {
+        int visible=-1,linked=-1;
+        if(strcmp(method,"hide")==0)visible=0;
+        if(strcmp(method,"show")==0)visible=1;
+        if(strcmp(method,"unlinkFromWorld")==0)linked=0;
+        if(strcmp(method,"linkIntoWorld")==0)linked=1;
+        if(strcmp(method,"delete")==0){visible=0;linked=0;}
+        if(strcmp(method,"notsolid")==0)linked=0;
+        if(id<0 || !r->host.entity_state || !r->host.entity_state(r->host.user,id,visible,linked))
+            rt_error(r,"GSC entity state rejected");
+    } else {char message[160];snprintf(message,sizeof(message),"GSC unsupported entity method: %s",method);rt_error(r,message);t->state=3;}
+}
