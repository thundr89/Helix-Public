+                    if(child->state==0)child->epoch=r->epoch+1;
+                }
+                if(child && child->state==3) {
+                    for(i=0;i<RT_THREADS;i++)if(r->threads[i]==child){r->threads[i]=NULL;break;}
+                    rt_free_thread(child);
+                }
