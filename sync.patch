+static int rt_notify_values(GscRuntime* r,int entity,int event,GscVal* args,int argc) {
+    int i,j,woken=0;
+    for(i=0;i<RT_THREADS;i++) {
+        RtThread* t=r->threads[i];if(!t || t->state==3)continue;
