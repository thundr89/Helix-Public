+            for(i=argc-1;i>=0;i--)args[i]=stack[--sp];
+            if(id==0) {
+                char message[160];snprintf(message,sizeof(message),"GSC unsupported builtin: %s",str_at(prog,ins->str));
+                rt_error(r,message);
+            }
+            if(id==GSC_BU_STRUCT){out.kind=V_OBJECT;out.p=arena_new_obj(&r->arena);if(!out.p){rt_error(r,"GSC object allocation limit");t->state=3;}}
